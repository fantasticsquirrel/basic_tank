{
  "expo": {
    "name": "Basic Tank Control",
    "slug": "basic-tank-control",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "ing.multihost.basictank",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.INTERNET", "android.permission.ACCESS_WIFI_STATE"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [["expo-build-properties", {"android": {"usesCleartextTraffic": true}}]]
  }
}
